Algoritmo " PositivoNegativo"

// Autor(a): Nome do(a) aluno(a)
// Data: 03/08/2026

Var
  numero : inteiro;

Inicio
  // Seção de Comando
  escreval("Informe um numero: ")
  leia (numero)

  se numero > 0 então
    escreval ("O numero é POSITIVO")
  senão
    escreval ("O numero é NEGATIVO")
  fimse

fimalgoritmo