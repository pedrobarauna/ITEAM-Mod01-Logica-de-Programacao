Algoritmo "Aula02_Ex02_BoasVindas"

// Autor: João Pedro Baraúna
// Aula: 02
// Exercício: 02
// Descrição: Solicita o nome do usuário e exibe uma mensagem de boas-vindas.

Var
  nome: caractere

Inicio
  // Seção de Comandos

  escreval("Digite seu nome:")
  leia(nome)

  escreval("Seja bem-vindo, ", nome, " ao curso de Fullstack!")

fimalgoritmo