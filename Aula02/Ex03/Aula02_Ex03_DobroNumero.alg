Algoritmo "Aula02_Ex03_DobroNumero"

// Autor: João Pedro Baraúna
// Aula: 02
// Exercício: 03
// Descrição: Solicita um número inteiro e exibe o seu dobro.

Var
  numero, dobro: inteiro

Inicio
  // Seção de Comandos

  escreval("Digite um número:")
  leia(numero)

  dobro <- numero * 2

  escreval("O dobro de ", numero, " é ", dobro)

fimalgoritmo