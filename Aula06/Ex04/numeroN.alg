Algoritmo "numeroN"

// Declaração das variáveis
Var
  numero : inteiro
  i : inteiro

Inicio

  // Solicita ao usuário um número
  escreval("Digite um numero: ")
  leia(numero)

  // Exibe os números de 1 até N, pulando de 2 em 2
  para i de 1 ate numero passo 2 faca
    // Mostra o valor atual de i
    escreval(i)
  fimpara

fimalgoritmo